{
  "manifest_version": 3,
  "name": "Skip This Job — Ghost Job Detector",
  "version": "0.2.2",
  "minimum_chrome_version": "111",
  "description": "Detect ghost job listings on LinkedIn and Indeed. Get ghost risk scores, repost tracking, and employer transparency.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://www.skipthisjob.com/*",
    "https://skipthisjob.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.linkedin.com/feed/*"
      ],
      "js": ["content/shared.js", "content/linkedin.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": ["content/indeed-mosaic-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": ["content/shared.js", "content/indeed.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
